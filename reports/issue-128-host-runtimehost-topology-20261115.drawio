<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="issue-128-host-runtimehost" name="Issue 128 — Windows RuntimeHost 構成">
    <mxGraphModel dx="2400" dy="1550" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1550" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Issue #128 — Windows ホスト RuntimeHost と Docker 周辺資源" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="2300" height="48" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="実験用 profile: Testing:Mode=base + Crane:Planner=visibility_graph + Testing:RuntimeHostOnWindows=true。Windows Docker Desktop の 通信経路と固定 CM4 image の実動作は未検証。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="2300" height="48" as="geometry" /></mxCell>
        <mxCell id="legend" value="凡例: 橙破線＝設計上の UDP 経路（実機未検証）／灰点線＝既存 CM4 loopback/helper 経路（固定 image では未検証）／青破線＝AppHost/Aspire 管理。紫の枠・ラベルは ホスト側の生成物と 読み取り専用 mount を示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="2300" height="50" as="geometry" /></mxCell>

        <mxCell id="windows-lane" value="Windows ホスト (.NET 10)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=21;fontStyle=1;fontColor=#233247;fillColor=#F0F7FF;strokeColor=#6E9AC7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="190" width="510" height="1240" as="geometry" /></mxCell>
        <mxCell id="docker-lane" value="Docker Desktop — Linux コンテナー（既存 image tag、変更なし）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=21;fontStyle=1;fontColor=#233247;fillColor=#FAFBFD;strokeColor=#8496AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="1815" height="1240" as="geometry" /></mxCell>

        <mxCell id="apphost" value="&lt;b&gt;Duck.Testing.AppHost.exe&lt;/b&gt;&lt;br&gt;Windows 上の .NET プロセス。Aspire/DCP が RuntimeHost と Docker 資源を管理&lt;br&gt;profile: base + visibility_graph（CM4 simulator）&lt;br&gt;duck-runtime image/コンテナーは登録しない" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=17;fontColor=#233247;fillColor=#E6F0FF;strokeColor=#4D7FB3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="250" width="450" height="175" as="geometry" /></mxCell>
        <mxCell id="runtimehost" value="&lt;b&gt;duck-host-runtime［Windows プロセス］&lt;/b&gt;&lt;br&gt;dotnet Tracker.RuntimeHost.dll&lt;br&gt;出力元: Tracker/Tracker.RuntimeHost/bin/{Debug|Release}/net10.0&lt;br&gt;Vision の受信待受先: 127.0.0.1:10020&lt;br&gt;Tracker の送信先: 127.0.0.1:&amp;lt;動的公開 relay UDP port&amp;gt;&lt;br&gt;Health HTTP: 127.0.0.1:39108&lt;br&gt;RuntimeHost source 変更後は AppHost build + restart。RuntimeHost publish と duck-runtime image build は不要。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=16;fontColor=#233247;fillColor=#EAF3FF;strokeColor=#4D7FB3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="485" width="450" height="280" as="geometry" /></mxCell>
        <mxCell id="host-artifacts" value="&lt;b&gt;ホスト側の build 入力 / 成果物&lt;/b&gt;&lt;br&gt;Tracker.RuntimeHost source → ホストプロセス 用 ローカル .NET 出力&lt;br&gt;UdpBoundaryRelay → Linux x64 self-contained 単一ファイル&lt;br&gt;Crane launch overlay → Linux x64 executable&lt;br&gt;cm4-transport-control → ビルド済み C ELF&lt;br&gt;コンテナーには選択した executable のみを mount。Duck C# source tree は含めない。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=16;fontColor=#233247;fillColor=#F3ECFA;strokeColor=#9978B6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="800" width="450" height="235" as="geometry" /></mxCell>
        <mxCell id="host-caveat" value="&lt;b&gt;未検証: Windows/Docker 境界&lt;/b&gt;&lt;br&gt;relay は host.docker.internal:10020 へ送信し、RuntimeHost は 127.0.0.1:10020 に bind。この UDP が Docker Desktop 経由で届くか未測定。Tracker UDP の host port 割当、multicast ingress/fan-out、restart 後の経路も未検証。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=16;fontColor=#7F1D1D;fillColor=#FEF2F2;strokeColor=#D97777;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="1090" width="450" height="265" as="geometry" /></mxCell>

        <mxCell id="simulator" value="&lt;b&gt;Simulator CLI コンテナー&lt;/b&gt;&lt;br&gt;image: ghcr.io/ibis-ssl/framework-simulatorcli:a52b6bd&lt;br&gt;Vision の出力先: multicast 224.5.23.2:10020&lt;br&gt;CM4 helper が command を simulator へ送り、feedback を CM4 へ中継&lt;br&gt;既存 image。Duck source mount なし。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=15;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="605" y="260" width="375" height="225" as="geometry" /></mxCell>
        <mxCell id="relay" value="&lt;b&gt;UDP 境界中継コンテナー&lt;/b&gt;&lt;br&gt;image: 既存 orion-cm4-sim:d7a2e07c47cf09c6d359e391f1cf2828f4fe7f5a（別コンテナー）&lt;br&gt;Duck .NET binary を読み取り専用 mount: /opt/duck/udp-boundary-relay&lt;br&gt;Vision: 224.5.23.2:10020 を受信し、host.docker.internal:10020 へ送信&lt;br&gt;Tracker: 0.0.0.0:11011 で受信（host 側 UDP port の動的公開）&lt;br&gt;224.5.23.2:11010 へ再 multicast。Duck source tree は含めず、image の再 build も不要。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=15;fontColor=#233247;fillColor=#F2F4F7;strokeColor=#7B8794;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1015" y="260" width="1300" height="290" as="geometry" /></mxCell>
        <mxCell id="cm4" value="&lt;b&gt;CM4 シミュレーターコンテナー&lt;/b&gt;&lt;br&gt;image: ghcr.io/ibis-ssl/orion-cm4-sim:d7a2e07c47cf09c6d359e391f1cf2828f4fe7f5a&lt;br&gt;C helper 読み取り専用 mount: /opt/duck/cm4-transport-control&lt;br&gt;command 入力: UDP :12345&lt;br&gt;CM4 の出力 loopback :12346。feedback loopback :50100+robot-id。&lt;br&gt;既存 image は変更しない。固定 image での実動作は未検証。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=14;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="605" y="655" width="375" height="270" as="geometry" /></mxCell>
        <mxCell id="crane" value="&lt;b&gt;Crane コンテナー&lt;/b&gt;&lt;br&gt;image: ghcr.io/ibis-ssl/crane:scenario-4063cd31cd5b11b1cc919003907f5f4c527b252d&lt;br&gt;launch overlay executable を読み取り専用 mount: /duck/crane-launch-overlay&lt;br&gt;ROS 2 周辺コンポーネント。CM4 の command UDP :12345 へ送信。&lt;br&gt;既存 image は変更しない。source tree mount なし。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=14;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1015" y="655" width="375" height="185" as="geometry" /></mxCell>
        <mxCell id="game-controller" value="&lt;b&gt;Game Controller コンテナー&lt;/b&gt;&lt;br&gt;image: robocupssl/ssl-game-controller:3.20.3&lt;br&gt;Vision の受信先: 224.5.23.2:10020&lt;br&gt;Tracker の受信先: 224.5.23.2:11010&lt;br&gt;既存の external image。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=15;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1425" y="655" width="375" height="185" as="geometry" /></mxCell>
        <mxCell id="consumers" value="&lt;b&gt;Tracker multicast 受信側&lt;/b&gt;&lt;br&gt;この base profile では Game Controller が 有効な受信側。&lt;br&gt;他の profile では同じ group に別の監視側が参加する。&lt;br&gt;payload bytes は維持されるが、受信元 IP:port は relay に変わる。MultiTracker は endpoint も key に含むため、切替時に重複 state となる可能性あり（未実測）。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=13;fontSize=15;fontColor=#233247;fillColor=#FFF8E1;strokeColor=#C9A94E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1835" y="655" width="480" height="185" as="geometry" /></mxCell>
        <mxCell id="no-duck-image" value="&lt;b&gt;duck-runtime image/コンテナーはこの profile では未登録&lt;/b&gt;&lt;br&gt;Tracker.RuntimeHost は Windows 上で実行。Docker image 内には置かない。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontSize=16;fontColor=#7C2D12;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1835" y="900" width="480" height="110" as="geometry" /></mxCell>
        <mxCell id="cm4-notes" value="&lt;b&gt;CM4 C-helper loopback 経路 — Windows/Docker relay とは別（既存コードの契約。実機未検証）&lt;/b&gt;&lt;br&gt;Crane → CM4 simulator :12345。CM4 simulator は 送信 packet を 127.0.0.1:12346 へ送り、C helper が simulator コンテナー :12346 へ中継。&lt;br&gt;Simulator feedback は helper の 50100+robot-id へ届き、helper が CM4 simulator の loopback 127.0.0.1:50100+robot-id へ中継。&lt;br&gt;C helper は /opt/duck/cm4-transport-control に 読み取り専用 mount。relay binary も同じ既存 image tag の別コンテナーに 読み取り専用 mount。&lt;br&gt;固定 image の native runtime の要件、Windows/Docker UDP、multicast fan-out、source endpoint の影響、restart 時の routing は実機での確認が必要。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=15;fontColor=#334155;fillColor=#F8FAFC;strokeColor=#A8B2BF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="605" y="1070" width="1710" height="285" as="geometry" /></mxCell>

        <mxCell id="apphost-runtime" value="Aspire が起動・監視" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3C78B4;fontColor=#3C78B4;fontSize=15;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apphost" target="runtimehost"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="apphost-docker" value="AppHost / DCP が Docker 資源を管理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3C78B4;fontColor=#3C78B4;fontSize=14;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.55;entryX=0;entryY=0.12;" edge="1" parent="1" source="apphost" target="docker-lane"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="vision-sim-relay" value="Vision multicast :10020（未検証）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#C26A24;fontColor=#A14F13;fontSize=14;strokeWidth=2.2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;entryX=0.08;entryY=1;" edge="1" parent="1" source="simulator" target="relay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="570" /><mxPoint x="1120" y="570" /></Array></mxGeometry></mxCell>
        <mxCell id="vision-relay-host" value="relay から host.docker.internal 経由で RuntimeHost へ（未検証）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#C26A24;fontColor=#A14F13;fontSize=14;strokeWidth=2.2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="relay" target="runtimehost"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="590" /><mxPoint x="540" y="590" /></Array></mxGeometry></mxCell>
        <mxCell id="tracker-host-relay" value="RuntimeHost → 動的公開 UDP port → relay :11011（未検証）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#C26A24;fontColor=#A14F13;fontSize=14;strokeWidth=2.2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=1;exitY=0.8;entryX=0.32;entryY=1;" edge="1" parent="1" source="runtimehost" target="relay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="620" /><mxPoint x="1430" y="620" /></Array></mxGeometry></mxCell>
        <mxCell id="tracker-relay-consumers" value="224.5.23.2:11010 へ再 multicast（fan-out 未測定）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#C26A24;fontColor=#A14F13;fontSize=14;strokeWidth=2.2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=0.82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="relay" target="consumers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="vision-sim-gc" value="Vision multicast の受信先 :10020" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#C26A24;fontColor=#A14F13;fontSize=13;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;exitX=0.78;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="simulator" target="game-controller"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="600" /><mxPoint x="1612" y="600" /></Array></mxGeometry></mxCell>
        <mxCell id="artifact-runtime" value="ローカル .NET build 出力" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#8D65A5;fontColor=#78538E;fontSize=13;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="host-artifacts" target="runtimehost"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="footer" value="検証状況: Linux build は成功。既存 identity/multicast 契約 test 14/14、host profile model test 1/1 は成功。これらは Windows Docker Desktop 上の実 packet 到達を証明しない。&lt;br&gt;Windows/Docker 間の双方向 UDP、固定 CM4 image 上での relay 実行、multicast fan-out、再起動後の動的 endpoint routing は未検証。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="1450" width="2300" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
