<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="issue-128-helper-free-target" name="Issue 128 helper-free target (candidate)">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Issue #128 — relay/helper-free topology candidate" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#17324d;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="16" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="候補: CM4 を network namespace owner、Simulator と Crane を follower にする。AppHost/DCP 管理面と Tracker.RuntimeHost データ面は別。実装・通信とも未成立。" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1520" height="45" as="geometry"/></mxCell>
        <mxCell id="host" value="Windows ホスト" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontStyle=1;fillColor=#eef6ff;strokeColor=#6b94c2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="120" width="360" height="720" as="geometry"/></mxCell>
        <mxCell id="docker" value="Docker Desktop / Aspire-managed Linux resources" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontStyle=1;fillColor=#f8fafc;strokeColor=#8797a8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="405" y="120" width="1170" height="720" as="geometry"/></mxCell>
        <mxCell id="apphost" value="&lt;b&gt;Duck.Testing.AppHost + Aspire/DCP&lt;/b&gt;&lt;br&gt;Control/management plane&lt;br&gt;resources, dependency order, health, recreation&lt;br&gt;&lt;br&gt;Candidate owner: cm4-sim&lt;br&gt;Followers: simulator + crane&lt;br&gt;DCP shared-network mode: unresolved (I81-07D follower start failed; cause not captured)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=16;fillColor=#e5efff;strokeColor=#4779b4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="165" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Tracker.RuntimeHost (.NET process)&lt;/b&gt;&lt;br&gt;Windows host candidate&lt;br&gt;not part of Docker bridge&lt;br&gt;&lt;br&gt;Current host profile accepts base only; comparison/match host coverage unresolved." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=16;fillColor=#eaf3ff;strokeColor=#4779b4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="475" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="hostudp" value="&lt;b&gt;Unresolved host ↔ Docker UDP data plane&lt;/b&gt;&lt;br&gt;Vision ingress to Windows: 224.5.23.2:10020&lt;br&gt;Tracker output back to Docker consumers: 224.5.23.2:11010&lt;br&gt;Both directions / multicast fan-out unverified without boundary relay." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=15;fontColor=#7f1d1d;fillColor=#fff1f1;strokeColor=#d27b7b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="675" width="310" height="140" as="geometry"/></mxCell>
        <mxCell id="shared" value="&lt;b&gt;候補: 1つの network namespace&lt;/b&gt;&lt;br&gt;CM4 owner + Simulator / Crane followers&lt;br&gt;Docker Engine の能力から Aspire/DCP 対応を推定しない" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=16;fontStyle=1;fillColor=#fffaf0;strokeColor=#c88f31;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="175" width="650" height="480" as="geometry"/></mxCell>
        <mxCell id="cm4" value="&lt;b&gt;CM4 simulator&lt;/b&gt; (`cm4-sim`)&lt;br&gt;command bind: 127.0.0.1:12345&lt;br&gt;command output: 127.0.0.1:12346&lt;br&gt;feedback bind: 127.0.0.1:50100+id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f5f5f5;strokeColor=#687786;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="485" y="275" width="275" height="155" as="geometry"/></mxCell>
        <mxCell id="sim" value="&lt;b&gt;SSL Simulator CLI&lt;/b&gt; (`simulator`)&lt;br&gt;input port: 12346&lt;br&gt;feedback target must be 127.0.0.1 in this candidate&lt;br&gt;current AppHost supplies CM4 bridge IPv4" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f5f5f5;strokeColor=#687786;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="795" y="250" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="crane" value="&lt;b&gt;Crane&lt;/b&gt; (`crane`)&lt;br&gt;default target: 127.0.0.1:12345&lt;br&gt;shared namespace could remove launch overlay target rewrite&lt;br&gt;restart/recreation unverified" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f5f5f5;strokeColor=#687786;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="795" y="455" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="gc" value="&lt;b&gt;Game Controller&lt;/b&gt;&lt;br&gt;existing base resource&lt;br&gt;Vision/tracker multicast fan-out from shared namespace not proven" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=15;fillColor=#f5f5f5;strokeColor=#687786;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1190" y="260" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="candidate-note" value="&lt;b&gt;Static endpoint alignment only; no packet acceptance&lt;/b&gt;&lt;br&gt;Crane → CM4 loopback :12345&lt;br&gt;CM4 → Simulator loopback :12346&lt;br&gt;Simulator → CM4 feedback loopback :50100+id (requires target override)&lt;br&gt;DCP owner/follower startup, multicast visibility, resource identity/recreation are unresolved." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=15;fontColor=#7c5a16;fillColor=#fff7e3;strokeColor=#c99a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="675" width="650" height="140" as="geometry"/></mxCell>
        <mxCell id="control-edge" value="proposed control/start dependency" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#487bb6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=13;fontColor=#365d8b;" edge="1" parent="1" source="apphost" target="shared"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="crane-edge" value="UDP 127.0.0.1:12345" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c8832f;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontColor=#8b5d24;" edge="1" parent="1" source="crane" target="cm4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cmd-edge" value="UDP 127.0.0.1:12346" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c8832f;strokeWidth=3;endArrow=block;endFill=1;fontSize=13;fontColor=#8b5d24;" edge="1" parent="1" source="cm4" target="sim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="feedback-edge" value="UDP 127.0.0.1:50100+id; target override unverified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c8832f;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#8b5d24;" edge="1" parent="1" source="sim" target="cm4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="vision-edge" value="Vision multicast ingress — unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b94e4e;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=13;fontColor=#8b3333;" edge="1" parent="1" source="sim" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tracker-edge" value="Tracker multicast return — unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b94e4e;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=13;fontColor=#8b3333;" edge="1" parent="1" source="runtime" target="gc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="profiles" value="&lt;b&gt;別の実装済み選択 profile（現 host trial 対象外）&lt;/b&gt;&lt;br&gt;comparison: `tigersmannheim/sumatra` / TIGERs tracker (`tracker-tigers`)、ER-Force tracker、DebugHost&lt;br&gt;match: `tigers-blue` (TIGERs Sumatra)、`autoref-tigers` (TIGERs AutoRef)、SSL log recorder、match controller。Host trial は Mode=base のみ受理し、これらの同時稼働を示さない。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontSize=16;fillColor=#f0f7f0;strokeColor=#76a076;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="865" width="1550" height="145" as="geometry"/></mxCell>
        <mxCell id="warning" value="現行 #129 の公開実装には C `cm4-transport-control`、.NET UDP boundary relay、Crane launch overlay がまだ存在する。上図は未実装 helper-free candidate であり、これらの撤去完了や Windows 通信成功を表さない。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fontSize=15;fontColor=#7f1d1d;fillColor=#fff1f1;strokeColor=#d27b7b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="25" y="1025" width="1550" height="75" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
