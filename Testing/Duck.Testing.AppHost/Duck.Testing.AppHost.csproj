<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Tracker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Duck.Testing.Diagnostics\Duck.Testing.Diagnostics.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Tracker\Tracker.RuntimeHost\Tracker.RuntimeHost.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Tracker\Tracker.DebugHost\Tracker.DebugHost.csproj" />
    <ProjectReference Include="..\..\TrackerConnectionLib\TrackerConnectionLib.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\SslProto\SslProto.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Duck.Testing.RefereeDriver\Duck.Testing.RefereeDriver.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Duck.Testing.CraneLaunchOverlay\Duck.Testing.CraneLaunchOverlay.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures\simulation_protocol_comparison.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\match\simulation_protocol_tigers.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\match\sumatra-user.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\match\ssl-game-controller-match.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\match\state-store-initial.json.stream" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\match\engine-config-initial.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(OutputPath)crane-launch-overlay"
             Link="crane-launch-overlay"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(IntermediateOutputPath)autoref-game-log-agent.jar"
             Condition="Exists('$(IntermediateOutputPath)autoref-game-log-agent.jar')"
             Link="autoref-game-log-agent.jar"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(IntermediateOutputPath)cm4-transport-control')">
    <Content Include="$(IntermediateOutputPath)cm4-transport-control"
             Link="cm4-transport-control"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishCraneLaunchOverlay" BeforeTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <CraneLaunchOverlayPublishDirectory>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)crane-launch-overlay-publish/</CraneLaunchOverlayPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\Duck.Testing.CraneLaunchOverlay\Duck.Testing.CraneLaunchOverlay.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=linux-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(CraneLaunchOverlayPublishDirectory)" />
    <Copy SourceFiles="$(CraneLaunchOverlayPublishDirectory)Duck.Testing.CraneLaunchOverlay"
          DestinationFiles="$(OutputPath)crane-launch-overlay" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Unix'))"
          Command="chmod 0755 &quot;$(OutputPath)crane-launch-overlay&quot;" />
  </Target>
</Project>
