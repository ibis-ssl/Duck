<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Tracker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Duck.Testing.Diagnostics\Duck.Testing.Diagnostics.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Tracker\Tracker.RuntimeHost\Tracker.RuntimeHost.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\Tracker\Tracker.DebugHost\Tracker.DebugHost.csproj" />
    <ProjectReference Include="..\..\TrackerConnectionLib\TrackerConnectionLib.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\SslProto\SslProto.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Duck.Testing.RefereeDriver\Duck.Testing.RefereeDriver.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures\simulation_protocol_comparison.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="CraneLaunchOverlay.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(IntermediateOutputPath)cm4-transport-control')">
    <Content Include="$(IntermediateOutputPath)cm4-transport-control"
             Link="cm4-transport-control"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
