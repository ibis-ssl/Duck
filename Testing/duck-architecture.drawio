<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="duck-main-flow" name="Duck 開発・実行フロー">
    <mxGraphModel dx="1800" dy="1700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1700" adaptiveColors="auto" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="windows-boundary" value="Windows process: 準備とAspire AppHost（ここはLinuxコンテナではない）" style="swimlane;startSize=34;html=1;whiteSpace=wrap;rounded=1;pointerEvents=0;align=left;spacingLeft=12;fontSize=20;fontStyle=1;fontColor=#233247;fillColor=#F0F7FF;strokeColor=#9BAFC3;strokeWidth=1.7;" vertex="1" parent="1">
          <mxGeometry x="10" y="125" width="1780" height="205" as="geometry" />
        </mxCell>
        <mxCell id="docker-boundary" value="Docker Desktop / Linux containers — base・comparisonではDuck送信、matchではDuckのUDP送信無効" style="swimlane;startSize=34;html=1;whiteSpace=wrap;rounded=1;pointerEvents=0;align=left;spacingLeft=12;fontSize=20;fontStyle=1;fontColor=#233247;fillColor=#FAFBFD;strokeColor=#9BAFC3;strokeWidth=1.7;" vertex="1" parent="1">
          <mxGeometry x="10" y="385" width="1780" height="835" as="geometry" />
        </mxCell>
        <mxCell id="duck-container" value="duck-runtime [Duck製image]: RuntimeHostのpublish出力 + 同projectのDockerfileからAppHostがbuild" style="swimlane;startSize=34;html=1;whiteSpace=wrap;rounded=1;pointerEvents=0;align=left;spacingLeft=12;fontSize=20;fontStyle=1;fontColor=#233247;fillColor=#F6F9FF;strokeColor=#9BAFC3;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="460" y="45" width="1320" height="250" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Duck: どこを編集し、何を起動し、何が流れるか" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=30;" vertex="1" parent="1">
          <mxGeometry x="25" y="12" width="1750" height="44" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="橙実線＝実行時データ　青破線＝起動・制御　紫破線＝ビルド・配置　灰点線＝外部実装の未確認経路&lt;br&gt;各boxは「入力 → 処理 → 出力」。[base] / [comparison] / [match] は同時起動ではなく設定モード。&lt;br&gt;紫点線・白抜き矢印＝ProjectReference（コンパイル時依存）。下段は代表的な参照のみ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="25" y="61" width="1750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;Windowsで準備 → AppHostを起動&lt;/b&gt;&lt;br&gt;Testing/README.md: Docker Desktop + .NET 10&lt;br&gt;必要hostをpublish → AppHostをbuild・run&lt;br&gt;更新したhostは再publishしてから再起動" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F1EBFA;strokeColor=#9978B6;strokeWidth=1.7;" vertex="1" parent="windows-boundary">
          <mxGeometry x="15.0" y="45" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="apphost" value="&lt;b&gt;Testing/Duck.Testing.AppHost [Windows]&lt;/b&gt;&lt;br&gt;入力: config / Fixtures / publish成果物&lt;br&gt;処理: Aspireで資源登録・所有権確認・健康監視&lt;br&gt;出力: Docker開発環境 / dashboard" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="windows-boundary">
          <mxGeometry x="615.0" y="45" width="570" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;AppHostのモードと開始条件&lt;/b&gt;&lt;br&gt;base: Simulator・Duck・GC・Crane（CM4は条件付き）&lt;br&gt;comparison: 比較tracker2種とDebugHostを追加&lt;br&gt;match: Blue AI・AutoRef・recorder・条件付きcontroller" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=1.7;" vertex="1" parent="windows-boundary">
          <mxGeometry x="1265.0" y="45" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="成果物 + 設定" edge="1" parent="windows-boundary" source="prepare" target="apphost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#8D65A5;fontColor=#8D65A5;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="構成を選択" edge="1" parent="windows-boundary" source="apphost" target="mode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3C78B4;fontColor=#3C78B4;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;Simulator [外部image]&lt;/b&gt;&lt;br&gt;入力: Crane / CM4の指令&lt;br&gt;処理: ロボット・ボール状態を模擬&lt;br&gt;出力: SSL-Vision Detection/Geometry&lt;br&gt;編集: AppHostのimage/引数設定" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="15.0" y="90" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="receive" value="&lt;b&gt;Tracker.RuntimeHost/&lt;/b&gt;&lt;br&gt;入力: UDP 224.5.23.2:10020&lt;br&gt;処理: Protobuf復号 → camera別最新buffer&lt;br&gt;出力: 16ms tickでCoordinatorへ投入&lt;br&gt;編集: Receiver / Buffer / OperationLoop" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="duck-container">
          <mxGeometry x="15.0" y="45" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;Tracker.Core/&lt;/b&gt;&lt;br&gt;入力: 観測 → 時刻順整理・Kalman追跡/統合&lt;br&gt;処理: 距離からball接触、履歴+速度からkick&lt;br&gt;出力: 確定world frame / event&lt;br&gt;編集: Engine / Contact.cs / Kick.cs" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="duck-container">
          <mxGeometry x="475.0" y="45" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="&lt;b&gt;Core/Proto → Runtime publisher&lt;/b&gt;&lt;br&gt;入力: TrackerFrame&lt;br&gt;処理: 公式packet生成（ns→s・mm→m）&lt;br&gt;出力: UDP sim 224.5.23.2:11010&lt;br&gt;編集: Generator / Publish設定" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="duck-container">
          <mxGeometry x="935.0" y="45" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Vision" edge="1" parent="docker-boundary" source="sim" target="receive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="packet" edge="1" parent="duck-container" source="receive" target="core" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="frame" edge="1" parent="duck-container" source="core" target="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="crane" value="&lt;b&gt;Crane [外部ROS 2 image]&lt;/b&gt;&lt;br&gt;入力: team・planner・送信先設定&lt;br&gt;処理: 戦術・ロボット指令（内部は未検証）&lt;br&gt;出力: CM4:12345 / simulator:12346&lt;br&gt;編集: AppHost / CraneLaunchOverlay" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="475.0" y="365" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cm4" value="&lt;b&gt;cm4-sim [外部image] + Duck helper&lt;/b&gt;&lt;br&gt;入力: Craneの指令&lt;br&gt;処理: CM4模擬＋Duck製helperでUDP転送&lt;br&gt;出力: simulator向け指令・feedback&lt;br&gt;編集: native/cm4-transport/" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="15.0" y="365" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="driver" value="&lt;b&gt;RefereeDriver.Host [Duck製image/任意]&lt;/b&gt;&lt;br&gt;入力: GCのReferee UDP + WS状態&lt;br&gt;処理: 受信とAPI照合 / readiness監視&lt;br&gt;出力: 診断・試合進行（有効設定時）&lt;br&gt;編集: Testing/...RefereeDriver*" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="935.0" y="365" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gc" value="&lt;b&gt;Game Controller [外部image]&lt;/b&gt;&lt;br&gt;入力: Vision / Tracker / WS制御action&lt;br&gt;処理: 試合状態の管理&lt;br&gt;出力: Referee 224.5.23.1:11003&lt;br&gt;API: ws://game-controller:8082/api/control" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="1395.0" y="365" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Tracker :11010" edge="1" parent="docker-boundary" source="publish" target="gc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" x="0.6" y="-20" />
        </mxCell>
        <mxCell id="d5" value="Referee / WS" edge="1" parent="docker-boundary" source="gc" target="driver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" y="-18" />
        </mxCell>
        <mxCell id="c2" value="有効時のaction" edge="1" parent="docker-boundary" source="driver" target="gc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3C78B4;fontColor=#3C78B4;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="指令" edge="1" parent="docker-boundary" source="crane" target="cm4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="IBIS / feedback" edge="1" parent="docker-boundary" source="cm4" target="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" x="0.6" y="20" />
        </mxCell>
        <mxCell id="dvision" value="Vision :10020" edge="1" parent="docker-boundary" source="sim" target="gc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;exitX=1;exitY=1;entryX=0.25;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;AutoRef Java agent [match]&lt;/b&gt;&lt;br&gt;入力: JVM起動 / modules=ACTIVE&lt;br&gt;処理: 既存録画APIを開始（判定は変更しない）&lt;br&gt;出力: writer open確認 / game log&lt;br&gt;編集: AppHost/AutoRefGameLogAgent/" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F1EBFA;strokeColor=#9978B6;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="15.0" y="630.0" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="auto" value="&lt;b&gt;autoref-tigers [match / 外部image]&lt;/b&gt;&lt;br&gt;入力: Vision / Tracker / RefereeのCLI設定&lt;br&gt;処理: --active --headless（外部判定）&lt;br&gt;出力: AutoRef自身のgame log&lt;br&gt;判定→GCの実動作/設定優先順位は未確認" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="475.0" y="630.0" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="debug" value="&lt;b&gt;DebugHost [Duck製image/任意]&lt;/b&gt;&lt;br&gt;comparison: Vision+Tracker → 比較/保存&lt;br&gt;base任意: Vision → 表示/保存&lt;br&gt;比較tracker: tigers / erforceは外部image&lt;br&gt;編集: DebugHost/Tracking・Vision・Components" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#EEF4FF;strokeColor=#5B8FF9;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="935.0" y="630.0" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="recorder" value="&lt;b&gt;ssl-log-recorder [match / 外部image]&lt;/b&gt;&lt;br&gt;入力: Vision / Tracker / Refereeの設定&lt;br&gt;処理: 独立したSSLログの保存&lt;br&gt;出力: bind先 recorder/&lt;br&gt;AutoRef自身のgamelogとは別" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#F3F4F6;strokeColor=#94A3B8;strokeWidth=1.7;" vertex="1" parent="docker-boundary">
          <mxGeometry x="1395.0" y="630.0" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="agent" edge="1" parent="docker-boundary" source="agent" target="auto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#8D65A5;fontColor=#8D65A5;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="Tracker" edge="1" parent="docker-boundary" source="publish" target="debug" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;entryX=1;entryY=0.5;jumpStyle=arc;jumpSize=8;">
          <mxGeometry relative="1" as="geometry" x="-0.68" y="-12" />
        </mxCell>
        <mxCell id="d9" value="Referee" edge="1" parent="docker-boundary" source="gc" target="recorder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B66F2E;fontColor=#B66F2E;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="判定（未確認）" edge="1" parent="docker-boundary" source="auto" target="gc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#9CA3AF;fontColor=#9CA3AF;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;dashPattern=2 4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="startup" value="&lt;b&gt;起動条件と補助物&lt;/b&gt;&lt;br&gt;開始待ち: CM4 → simulator → Duck、DuckのWaitForStart + GCのWaitFor → Crane（CraneはCM4開始も待つ）。GC自身にDuckのWaitForは無い。&lt;br&gt;CM4: visibility_graph またはmatchで使用。base/rvo2では不要。overlayはAppHost buildでLinux向けpublish。CM4 helper/JARは存在時copyで生成手順はREADME。&lt;br&gt;modeの追加: matchのtigers-blue、MatchReadinessOnly=false時のmatch-controller、comparisonの条件付きrelay。外部imageの内部動作・通信到達は今回未検証。&lt;br&gt;Duck製imageはRuntimeHost / DebugHost / RefereeDriver.Hostの各publish出力とDockerfileからbuild。灰色boxは外部提供imageを使用（helperはDuck製）。" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fontSize=19;fontColor=#233247;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=1.7;" vertex="1" parent="1">
          <mxGeometry x="25" y="1230" width="1750" height="135" as="geometry" />
        </mxCell>
        <mxCell id="index" value="索引（全14ルート）: 実装 Tracker / Testing / TrackerConnectionLib / TrackerConnectionLibExample / SslProto ｜ 補助 native / scripts / tools / .github&lt;br&gt;文書・記録 reports / handoffs / feedback-points ｜ 外部 reference/specs / .agents。Protocol用2件+specsは外部submodule（当作業木は未初期化）。bin/obj/artifacts等は生成物。&lt;br&gt;根拠: AppHost Program.cs・BaseSimulationResourceRegistration.cs / RuntimeHost appsettings.json・Receiver/Buffer/Loop / Core Engine/{Contact,Kick,FrameCommit}.cs・Runtime/TrackerCoordinator.Dispatch.cs。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="1565" width="1750" height="80" as="geometry" />
        </mxCell>
        <mxCell id="base" value="ソース基準 main: ab416fd6481ee1e91e671f503c5b6c8751a5cb4e ｜改訂開始時 PR #127 HEAD: 32868edc25e37fd73f28d0e36360701b3da97d5c ｜ 2026-11-14 静的確認" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="25" y="1660" width="1750" height="25" as="geometry" />
        </mxCell>
