          <mxGeometry x="25" y="335" width="750" height="35" as="geometry" />
        </mxCell>
        <mxCell id="image-legend-b" value="灰: 外部提供image　紫: Duck製の補助プログラム/成果物" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1075" y="335" width="700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="compose-boundary" value="起動/監視" edge="1" parent="1" source="apphost" target="docker-boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#3C78B4;fontColor=#3C78B4;fontSize=17;strokeWidth=2;labelBackgroundColor=#FFFFFF;defaultLabelBackgroundColor=page;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="refs-title" value="コンパイル時の参照（.csprojで確認）: 起動やUDP通信を表す線とは別" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#233247;fontSize=18;" vertex="1" parent="1">
