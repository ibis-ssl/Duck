@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Tracker.Server.Components.Vision
@using Tracker.Server.Tracking
@using Tracker.Server.Vision

<section class="diagnostics-overlay-field field-card">
    <div class="field-card__toolbar diagnostics-overlay-field__toolbar">
        <span>Overlay</span>
        <div class="diagnostics-overlay-field__legend" aria-label="Overlay layer legend">
            @foreach (var layer in Model.Layers)
            {
                <label class="diagnostics-overlay-field__legend-item">
                    <input type="checkbox"
                           checked="@layer.IsVisible"
                           @onchange="@((args) => OnLayerVisibilityChanged(layer.LayerKey, args))" />
                    <span class="diagnostics-overlay-field__swatch" style="background:@layer.AccentColor"></span>
                    <span class="diagnostics-overlay-field__layer">@layer.LayerName</span>
                    <span>@layer.SourceLabel</span>
                    @if (!string.IsNullOrWhiteSpace(layer.LegendNote))
                    {
                        <span>@layer.LegendNote</span>
                    }
                    <span>@layer.Status</span>
                    <span>delta @Display(layer.NearestDeltaNs)</span>
                    <span>draw @layer.DrawableCount.ToString(CultureInfo.InvariantCulture)</span>
                </label>
            }
        </div>
    </div>

    @if (Model.Geometry is null)
    {
        <div class="diagnostics-overlay-field__empty">@Display(Model.EmptyState)</div>
    }
    else
    {
        <div class="field-card__canvas">
            @{
                var projection = VisionFieldProjection.FromGeometry(Model.Geometry);
                var field = Model.Geometry.Field;
                var (boundaryWidthGoalLine, boundaryWidthTouchLine) = ResolveBoundaryWidths(Model.Geometry);
                var outerLengthMargin = Math.Max(boundaryWidthGoalLine, field?.GoalDepth ?? 0);
                var fieldTopLeft = projection.Project(-projection.FieldLength / 2, projection.FieldWidth / 2);
                var fieldWidth = projection.ProjectLength(projection.FieldLength);
                var fieldHeight = projection.ProjectLength(projection.FieldWidth);
                var boundaryTopLeft = projection.Project(
                    -(projection.FieldLength / 2 + outerLengthMargin),
                    projection.FieldWidth / 2 + boundaryWidthTouchLine);
                var boundaryWidthProjected = projection.ProjectLength(projection.FieldLength + (outerLengthMargin * 2));
                var boundaryHeightProjected = projection.ProjectLength(projection.FieldWidth + (boundaryWidthTouchLine * 2));
            }

            <svg class="field-card__svg diagnostics-overlay-field__svg"
                 viewBox="@ViewBox(projection)"
                 role="img"
                 aria-label="Diagnostics overlay field">
                <g pointer-events="none">
                    <rect class="field-card__boundary-background"
                          x="@N(boundaryTopLeft.X)"
                          y="@N(boundaryTopLeft.Y)"
                          width="@N(boundaryWidthProjected)"
                          height="@N(boundaryHeightProjected)" />

                    <rect class="field-card__boundary"
                          x="@N(fieldTopLeft.X)"
                          y="@N(fieldTopLeft.Y)"
                          width="@N(fieldWidth)"
                          height="@N(fieldHeight)" />

                    <VisionFieldLines Projection="projection" Field="field" />

                    @foreach (var layer in Model.Layers.Where(layer => layer.IsVisible && layer.DrawableCount > 0))
                    {
                        <g class="@LayerClass(layer.LayerKey)">
                            @foreach (var ball in layer.Balls)
                            {
                                <VisionBallMarker Projection="projection" Ball="ball" Style="@MarkerStyle(layer.AccentColor)" />
                            }

                            @foreach (var robot in layer.RobotsYellow)
                            {
                                <VisionRobotMarker Projection="projection"
                                                   Robot="robot"
                                                   ClassName="robot-yellow"
                                                   MarkerStroke="@layer.AccentColor" />
                            }

                            @foreach (var robot in layer.RobotsBlue)
                            {
                                <VisionRobotMarker Projection="projection"
                                                   Robot="robot"
                                                   ClassName="robot-blue"
                                                   MarkerStroke="@layer.AccentColor" />
                            }
                        </g>
                    }
                </g>
            </svg>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public DiagnosticsFieldOverlayRenderModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback<(TrackerDiagnosticsOverlayLayerKey LayerKey, bool IsVisible)> VisibilityChanged { get; set; }

    private static string ViewBox(VisionFieldProjection projection)
    {
        return $"0 0 {N(projection.ViewBoxWidth)} {N(projection.ViewBoxHeight)}";
    }

    private static (double GoalLine, double TouchLine) ResolveBoundaryWidths(SSL_GeometryData? geometry)
    {
        var field = geometry?.Field;
        var touchLine = field?.BoundaryWidth > 0 ? field.BoundaryWidth : 300;
        var goalLine = field?.BoundaryWidthGoalLine > 0 ? field.BoundaryWidthGoalLine : touchLine;
        return (goalLine, touchLine);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string Display(long? value)
    {
        return value?.ToString(CultureInfo.InvariantCulture) ?? "-";
    }

    private static string N(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }

    private static string MarkerStyle(string accentColor)
    {
        return $"stroke:{accentColor};stroke-width:2.8;opacity:0.92";
    }

    private static string LayerClass(TrackerDiagnosticsOverlayLayerKey layerKey)
    {
        return layerKey == TrackerDiagnosticsOverlayLayerKey.LayerA
            ? "diagnostics-overlay-field__layer-group diagnostics-overlay-field__layer-group--a"
            : "diagnostics-overlay-field__layer-group diagnostics-overlay-field__layer-group--b";
    }

    private Task OnLayerVisibilityChanged(
        TrackerDiagnosticsOverlayLayerKey layerKey,
        ChangeEventArgs args)
    {
        var isVisible = args.Value is bool boolValue && boolValue;
        return VisibilityChanged.InvokeAsync((layerKey, isVisible));
    }
}
