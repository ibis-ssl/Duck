@page "/"
@using System.Globalization
@using System.Text.Json
@using Google.Protobuf
@using Tracker.Server.Tracking
@using Tracker.Server.Vision
@inject VisionPacketStore Store
@inject TrackedSnapshotStore TrackedStore
@implements IAsyncDisposable

<PageTitle>Tracker.Server</PageTitle>

<section class="vision-shell">
    <header class="vision-header">
        <div class="vision-status">
            <div>
                <span>Packets</span>
                <strong>@rawSnapshot.PacketCount</strong>
            </div>
            <div>
                <span>Errors</span>
                <strong>@rawSnapshot.ErrorCount</strong>
            </div>
            <div>
                <span>Remote</span>
                <strong>@(rawSnapshot.RemoteEndpoint ?? "-")</strong>
            </div>
            <div>
                <span>Received</span>
                <strong>@FormatTimestamp(CurrentReceivedAt)</strong>
            </div>
        </div>
        <div class="vision-mode-toggle" role="tablist" aria-label="Viewer mode selector">
            <button type="button"
                    class="@ModeButtonClass(ViewerMode.Raw)"
                    @onclick="@(() => SelectMode(ViewerMode.Raw))">
                Raw
            </button>
            <button type="button"
                    class="@ModeButtonClass(ViewerMode.Tracked)"
                    @onclick="@(() => SelectMode(ViewerMode.Tracked))">
                Tracked
            </button>
        </div>
    </header>

    @if (rawSnapshot.LastError is not null)
    {
        <div class="vision-alert">@rawSnapshot.LastError</div>
    }

    @{
        var selectedView = ResolveSelectedView(rawSnapshot);
        var trackedView = TrackedVisionViewState.FromSnapshot(trackedSnapshot);
    }

    <div class="vision-grid">
        @if (viewerMode == ViewerMode.Raw)
        {
            <VisionFieldCanvas Geometry="rawSnapshot.Geometry"
                               Balls="selectedView.Balls"
                               RobotsYellow="selectedView.RobotsYellow"
                               RobotsBlue="selectedView.RobotsBlue" />

            <VisionDetailsPanel ViewLabel="selectedView.Label"
                                FrameLabel="selectedView.FrameLabel"
                                CameraLabel="selectedView.CameraLabel"
                                SourceLabel="selectedView.SourceLabel"
                                RawJson="selectedView.RawJson"
                                Cameras="rawSnapshot.Cameras"
                                SelectedViewKey="selectedViewKey"
                                OnSelectView="SelectView"
                                Geometry="rawSnapshot.Geometry"
                                Balls="selectedView.Balls"
                                RobotsYellow="selectedView.RobotsYellow"
                                RobotsBlue="selectedView.RobotsBlue" />
        }
        else
        {
            <VisionFieldCanvas Geometry="trackedView.Geometry"
                               Balls="trackedView.Balls"
                               RobotsYellow="trackedView.RobotsYellow"
                               RobotsBlue="trackedView.RobotsBlue" />

            <TrackedDetailsPanel ViewState="trackedView" />
        }
    </div>
</section>

@code {
    private const string AggregateViewKey = "aggregate";
    private readonly CancellationTokenSource disposalTokenSource = new();
    private VisionPacketSnapshot rawSnapshot = VisionPacketSnapshot.Empty;
    private TrackedSnapshot trackedSnapshot = new(null, null, "default", 0, 0);
    private Task? refreshTask;
    private string selectedViewKey = AggregateViewKey;
    private ViewerMode viewerMode = ViewerMode.Raw;

    protected override void OnInitialized()
    {
        rawSnapshot = Store.GetSnapshot();
        trackedSnapshot = TrackedStore.GetSnapshot();
        EnsureSelectedViewExists(rawSnapshot);
        refreshTask = RefreshAsync(disposalTokenSource.Token);
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));

        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            rawSnapshot = Store.GetSnapshot();
            trackedSnapshot = TrackedStore.GetSnapshot();
            EnsureSelectedViewExists(rawSnapshot);
            await InvokeAsync(StateHasChanged);
        }
    }

    private DateTimeOffset? CurrentReceivedAt => viewerMode == ViewerMode.Tracked
        ? trackedSnapshot.ReceivedAt
        : rawSnapshot.ReceivedAt;

    private static string FormatTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture) ?? "-";
    }

    private static string FormatJson(IMessage? message)
    {
        return message is null ? "{}" : JsonFormatter.Default.Format(message);
    }

    private static string FormatAggregateJson(VisionAggregateDetectionSnapshot aggregate)
    {
        var payload = new
        {
            view = "aggregate",
            cameraIds = aggregate.CameraIds,
            balls = aggregate.Balls.Select(ball => new
            {
                confidence = ball.Confidence,
                x = ball.X,
                y = ball.Y,
                z = ball.Z,
                pixelX = ball.PixelX,
                pixelY = ball.PixelY,
            }),
            robotsYellow = aggregate.RobotsYellow.Select(robot => new
            {
                confidence = robot.Confidence,
                robotId = robot.RobotId,
                x = robot.X,
                y = robot.Y,
                orientation = robot.Orientation,
                pixelX = robot.PixelX,
                pixelY = robot.PixelY,
                height = robot.Height,
            }),
            robotsBlue = aggregate.RobotsBlue.Select(robot => new
            {
                confidence = robot.Confidence,
                robotId = robot.RobotId,
                x = robot.X,
                y = robot.Y,
                orientation = robot.Orientation,
                pixelX = robot.PixelX,
                pixelY = robot.PixelY,
                height = robot.Height,
            }),
        };

        return JsonSerializer.Serialize(payload, new JsonSerializerOptions
        {
            WriteIndented = true,
        });
    }

    private Task SelectView(string key)
    {
        selectedViewKey = key;
        return Task.CompletedTask;
    }

    private Task SelectMode(ViewerMode mode)
    {
        viewerMode = mode;
        return Task.CompletedTask;
    }

    private void EnsureSelectedViewExists(VisionPacketSnapshot currentSnapshot)
    {
        if (selectedViewKey == AggregateViewKey)
        {
            return;
        }

        if (TryGetCameraId(selectedViewKey, out var cameraId) &&
            currentSnapshot.Cameras.Any(camera => camera.CameraId == cameraId))
        {
            return;
        }

        selectedViewKey = AggregateViewKey;
    }

    private VisionViewState ResolveSelectedView(VisionPacketSnapshot currentSnapshot)
    {
        if (selectedViewKey == AggregateViewKey)
        {
            return new VisionViewState(
                AggregateViewKey,
                "Aggregate",
                currentSnapshot.Cameras.Count > 0 ? "aggregate" : "-",
                currentSnapshot.Cameras.Count > 0 ? string.Join(", ", currentSnapshot.AggregateDetection.CameraIds) : "-",
                "aggregate",
                currentSnapshot.AggregateDetection.Balls,
                currentSnapshot.AggregateDetection.RobotsYellow,
                currentSnapshot.AggregateDetection.RobotsBlue,
                FormatAggregateJson(currentSnapshot.AggregateDetection));
        }

        if (TryGetCameraId(selectedViewKey, out var cameraId))
        {
            var camera = currentSnapshot.Cameras.FirstOrDefault(entry => entry.CameraId == cameraId);
            if (camera is not null)
            {
                return new VisionViewState(
                    CameraViewKey(camera.CameraId),
                    $"Camera {camera.CameraId}",
                    camera.Detection.FrameNumber.ToString(CultureInfo.InvariantCulture),
                    camera.CameraId.ToString(CultureInfo.InvariantCulture),
                    camera.LatestPacket?.Source.ToString() ?? "-",
                    camera.Detection.Balls,
                    camera.Detection.RobotsYellow,
                    camera.Detection.RobotsBlue,
                    FormatJson(camera.LatestPacket));
            }
        }

        selectedViewKey = AggregateViewKey;
        return ResolveSelectedView(currentSnapshot);
    }

    private static string CameraViewKey(uint cameraId)
    {
        return $"camera:{cameraId}";
    }

    private static bool TryGetCameraId(string key, out uint cameraId)
    {
        const string prefix = "camera:";

        if (key.StartsWith(prefix, StringComparison.Ordinal) &&
            uint.TryParse(key[prefix.Length..], CultureInfo.InvariantCulture, out cameraId))
        {
            return true;
        }

        cameraId = 0;
        return false;
    }

    private sealed record VisionViewState(
        string Key,
        string Label,
        string FrameLabel,
        string CameraLabel,
        string SourceLabel,
        IReadOnlyList<SSL_DetectionBall> Balls,
        IReadOnlyList<SSL_DetectionRobot> RobotsYellow,
        IReadOnlyList<SSL_DetectionRobot> RobotsBlue,
        string RawJson);

    private string ModeButtonClass(ViewerMode mode)
    {
        return viewerMode == mode ? "vision-mode-toggle__button is-active" : "vision-mode-toggle__button";
    }

    private enum ViewerMode
    {
        Raw,
        Tracked,
    }

    public async ValueTask DisposeAsync()
    {
        await disposalTokenSource.CancelAsync();

        if (refreshTask is not null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        disposalTokenSource.Dispose();
    }
}
