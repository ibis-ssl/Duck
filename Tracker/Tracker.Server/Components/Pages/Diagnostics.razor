@page "/diagnostics"
@using System.Globalization
@using System.Text.Json
@using Tracker.Core
@using Tracker.Server.Components.Vision
@using Tracker.Server.Tracking
@inject TrackerDiagnosticsLogReader LogReader
@inject TrackerRenderSnapshotLogReader RenderSnapshotReader
@inject TrackerDiagnosticsComparisonViewStateReader ComparisonReader

<PageTitle>Diagnostics</PageTitle>

<section class="@ShellClass()">
    <header class="diagnostics-header">
        <div class="diagnostics-toolbar">
            <select class="diagnostics-select"
                    value="@selectedLogPath"
                    @onchange="OnLogFileChanged"
                    aria-label="Diagnostics log file">
                @foreach (var file in logFiles)
                {
                    <option value="@file.FullPath">@file.FileName</option>
                }
            </select>
            <button type="button" class="diagnostics-button" @onclick="ReloadAsync">Reload</button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(snapshot?.Error))
    {
        <div class="diagnostics-alert">@snapshot.Error</div>
    }
    else if (logFiles.Count == 0)
    {
        <div class="diagnostics-alert">No tracker diagnostics logs found.</div>
    }
    else
    {
        <div class="diagnostics-grid"
             style="@TimelineAreaStyle()"
             @onmousemove="OnTimelineResizeMove"
             @onmouseup="OnTimelineResizeEnd"
             @onmouseleave="OnTimelineResizeEnd">
            <aside class="diagnostics-timeline" aria-label="Diagnostics timeline">
                @foreach (var entry in entries)
                {
                    <button type="button"
                            class="@TimelineItemClass(entry)"
                            @onclick="@(() => SelectEntry(entry))">
                        <span class="diagnostics-timeline__time">@FormatTime(entry.Timestamp)</span>
                        <span class="diagnostics-timeline__frame">output frame @entry.TrackedFrame</span>
                        <span class="diagnostics-timeline__counts">
                            vision balls @entry.RawBallCount / output @entry.TrackedBallCount
                        </span>
                    </button>
                }
            </aside>
            <div class="@TimelineResizeHandleClass()"
                 role="separator"
                 aria-orientation="vertical"
                 aria-valuemin="@DiagnosticsRenderLayoutState.MinTimelineWidthRem"
                 aria-valuemax="@DiagnosticsRenderLayoutState.MaxTimelineWidthRem"
                 aria-valuenow="@timelineWidthRem"
                 tabindex="0"
                 @onmousedown="OnTimelineResizeStart"
                 @onmousedown:preventDefault="true"
                 @onkeydown="OnTimelineResizeKeyDown">
            </div>

            <main class="diagnostics-detail"
                  style="@RenderAreaStyle()"
                  @onmousemove="OnRenderResizeMove"
                  @onmouseup="OnRenderResizeEnd"
                  @onmouseleave="OnRenderResizeEnd">
                @if (selectedEntry is null)
                {
                    <div class="diagnostics-empty">No entry selected.</div>
                }
                else
                {
                    <div class="diagnostics-detail__header">
                        <div>
                            <span>Time</span>
                            <strong>@selectedEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture)</strong>
                        </div>
                        <div>
                            <span>Profile</span>
                            <strong>@selectedEntry.ProfileName</strong>
                            @if (profileMetadata is not null)
                            {
                                <button type="button" class="diagnostics-profile-link" @onclick="OpenProfileSettings">Settings</button>
                            }
                        </div>
                        <div>
                            <span>Line</span>
                            <strong>@selectedEntry.LineNumber</strong>
                        </div>
                        <div>
                            <span>Files</span>
                            <strong>@logFiles.Count</strong>
                        </div>
                        <div>
                            <span>Entries</span>
                            <strong>@entries.Count</strong>
                        </div>
                        <div>
                            <span>Skipped</span>
                            <strong>@(snapshot?.SkippedLineCount ?? 0)</strong>
                        </div>
                        <div>
                            <span>Selected</span>
                            <strong>@selectedEntry.TrackedFrame</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(profileMetadataError))
                    {
                        <div class="diagnostics-profile-alert">@profileMetadataError</div>
                    }

                    <section class="diagnostics-comparison" aria-label="Tracker comparison">
                        <header class="diagnostics-comparison__header">
                            <h2>Tracker Comparison</h2>
                            <button type="button"
                                    class="diagnostics-comparison__toggle"
                                    @onclick="ToggleComparisonPanelAsync"
                                    aria-expanded="@(!(comparisonUiState?.IsComparisonPanelCollapsed ?? false))">
                                @ComparisonPanelToggleLabel()
                            </button>
                        </header>

                        @if (!(comparisonUiState?.IsComparisonPanelCollapsed ?? false))
                        {
                            <div class="diagnostics-comparison__controls">
                                <select class="diagnostics-select diagnostics-comparison__select"
                                        value="@ComparisonSourceFilterValue()"
                                        @onchange="OnComparisonSourceFilterChanged"
                                        aria-label="Comparison source filter">
                                    @foreach (var option in ComparisonViewState.SourceOptions)
                                    {
                                        <option value="@TrackerDiagnosticsComparisonUiState.ToFilterValue(option.Filter)">
                                            @option.Label (@option.RecordCount)
                                        </option>
                                    }
                                </select>
                            </div>

                            <dl class="diagnostics-comparison__stats">
                                <dt>Status</dt>
                                <dd>@ComparisonViewState.SidecarStatus</dd>
                                <dt>Records</dt>
                                <dd>@ComparisonViewState.RecordCount</dd>
                                <dt>Skipped</dt>
                                <dd>@ComparisonViewState.SkippedRecordCount</dd>
                                <dt>Errors</dt>
                                <dd>@ComparisonViewState.ErrorCount</dd>
                                <dt>Selected frame</dt>
                                <dd>@Display(selectedEntry.TrackedFrame)</dd>
                                <dt>Selected time</dt>
                                <dd>@selectedEntry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</dd>
                            </dl>

                            @if (!string.IsNullOrEmpty(ComparisonViewState.Error))
                            {
                                <div class="diagnostics-comparison__alert">@ComparisonViewState.Error</div>
                            }

                            @if (ComparisonViewState.SelectedEntryComparison is { } comparison)
                            {
                                <dl class="diagnostics-comparison__stats diagnostics-comparison__stats--comparison">
                                    <dt>Entry status</dt>
                                    <dd>@comparison.Status</dd>
                                    <dt>Line</dt>
                                    <dd>@Display(comparison.EntryLineNumber)</dd>
                                    <dt>Rule</dt>
                                    <dd>@Display(comparison.MatchingRule)</dd>
                                    <dt>Source role</dt>
                                    <dd>@Display(comparison.NearestSnapshotSourceRole)</dd>
                                    <dt>Source label</dt>
                                    <dd>@Display(comparison.NearestSnapshotSourceLabel)</dd>
                                    <dt>Snapshot frame</dt>
                                    <dd>@Display(comparison.NearestSnapshotTrackedFrameNumber)</dd>
                                    <dt>Own timestamp ns</dt>
                                    <dd>@Display(comparison.IbisOwnSnapshotTimestampNs)</dd>
                                    <dt>Nearest timestamp ns</dt>
                                    <dd>@Display(comparison.NearestSnapshotTimestampNs)</dd>
                                    <dt>Delta ns</dt>
                                    <dd>@Display(comparison.TimestampDeltaNs)</dd>
                                    <dt>Balls</dt>
                                    <dd>@Display(comparison.BallCount)</dd>
                                    <dt>Robots</dt>
                                    <dd>@Display(comparison.RobotCount)</dd>
                                    <dt>Raw payload</dt>
                                    <dd>@DisplayRawPayloadRestored(comparison.RawPayloadRestored)</dd>
                                </dl>
                            }
                        }
                    </section>

                    @if (selectedRenderSnapshot is not null)
                    {
                        var leftField = LeftFieldRenderModel();
                        var rightField = RightFieldRenderModel();
                        var isOverlayMode = comparisonUiState?.FieldDisplayMode == TrackerDiagnosticsFieldDisplayMode.Overlay;
                        <div class="diagnostics-field-display">
                            <div class="diagnostics-field-display__mode">
                                <span>Field view</span>
                                <select class="diagnostics-select diagnostics-field-mode__select"
                                        value="@FieldDisplayModeValue()"
                                        @onchange="OnFieldDisplayModeChanged"
                                        aria-label="Field display mode">
                                    <option value="@TrackerDiagnosticsFieldDisplayMode.Split">Split</option>
                                    <option value="@TrackerDiagnosticsFieldDisplayMode.Overlay">Overlay</option>
                                </select>
                            </div>
                        </div>
                        @if (isOverlayMode)
                        {
                            var overlayField = OverlayFieldRenderModel();
                            <div class="diagnostics-render diagnostics-render--overlay">
                                <section>
                                    <header class="diagnostics-render__header diagnostics-render__header--overlay">
                                        <h2>Overlay Field</h2>
                                        <div class="diagnostics-field-source__overlay-selectors">
                                            <label>
                                                <span>Layer A</span>
                                                <select class="diagnostics-select diagnostics-field-source__select"
                                                        value="@LeftFieldSourceValue()"
                                                        @onchange="OnLeftFieldSourceChanged"
                                                        aria-label="Layer A Field source">
                                                    @foreach (var option in ComparisonViewState.FieldSourceOptions)
                                                    {
                                                        <option value="@TrackerDiagnosticsComparisonUiState.ToFieldSourceValue(option.Source)">
                                                            @option.Label
                                                        </option>
                                                    }
                                                </select>
                                            </label>
                                            <label>
                                                <span>Layer B</span>
                                                <select class="diagnostics-select diagnostics-field-source__select"
                                                        value="@RightFieldSourceValue()"
                                                        @onchange="OnRightFieldSourceChanged"
                                                        aria-label="Layer B Field source">
                                                    @foreach (var option in ComparisonViewState.FieldSourceOptions)
                                                    {
                                                        <option value="@TrackerDiagnosticsComparisonUiState.ToFieldSourceValue(option.Source)">
                                                            @option.Label
                                                        </option>
                                                    }
                                                </select>
                                            </label>
                                        </div>
                                    </header>
                                    <DiagnosticsFieldOverlayCanvas Model="overlayField"
                                                                   VisibilityChanged="OnOverlayLayerVisibilityChanged" />
                                </section>
                            </div>
                        }
                        else
                        {
                            <div class="diagnostics-render">
                                <section>
                                    <header class="diagnostics-render__header">
                                        <h2>@leftField.Title Field</h2>
                                        <select class="diagnostics-select diagnostics-field-source__select"
                                                value="@LeftFieldSourceValue()"
                                                @onchange="OnLeftFieldSourceChanged"
                                                aria-label="Left Field source">
                                            @foreach (var option in ComparisonViewState.FieldSourceOptions)
                                            {
                                                <option value="@TrackerDiagnosticsComparisonUiState.ToFieldSourceValue(option.Source)">
                                                    @option.Label
                                                </option>
                                            }
                                        </select>
                                    </header>
                                    @if (!string.IsNullOrEmpty(leftField.Status))
                                    {
                                        <div class="diagnostics-field-source__status">@leftField.Status</div>
                                    }
                                    <VisionFieldCanvas Geometry="leftField.Geometry"
                                                       Balls="leftField.Balls"
                                                       RobotsYellow="leftField.RobotsYellow"
                                                       RobotsBlue="leftField.RobotsBlue" />
                                </section>
                                <section>
                                    <header class="diagnostics-render__header">
                                        <h2>@rightField.Title Field</h2>
                                        <select class="diagnostics-select diagnostics-field-source__select"
                                                value="@RightFieldSourceValue()"
                                                @onchange="OnRightFieldSourceChanged"
                                                aria-label="Right Field source">
                                            @foreach (var option in ComparisonViewState.FieldSourceOptions)
                                            {
                                                <option value="@TrackerDiagnosticsComparisonUiState.ToFieldSourceValue(option.Source)">
                                                    @option.Label
                                                </option>
                                            }
                                        </select>
                                    </header>
                                    @if (!string.IsNullOrEmpty(rightField.Status))
                                    {
                                        <div class="diagnostics-field-source__status">@rightField.Status</div>
                                    }
                                    <VisionFieldCanvas Geometry="rightField.Geometry"
                                                       Balls="rightField.Balls"
                                                       RobotsYellow="rightField.RobotsYellow"
                                                       RobotsBlue="rightField.RobotsBlue" />
                                </section>
                            </div>
                        }
                        <div class="@RenderResizeHandleClass()"
                             role="separator"
                             aria-orientation="horizontal"
                             aria-valuemin="@DiagnosticsRenderLayoutState.MinHeightRem"
                             aria-valuemax="@DiagnosticsRenderLayoutState.MaxHeightRem"
                             aria-valuenow="@renderAreaHeightRem"
                             tabindex="0"
                             @onmousedown="OnRenderResizeStart"
                             @onmousedown:preventDefault="true"
                             @onkeydown="OnRenderResizeKeyDown">
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(renderSnapshotError))
                    {
                        <div class="diagnostics-render-alert">@renderSnapshotError</div>
                    }

                    <div class="diagnostics-detail__columns">
                        <section class="diagnostics-detail-panel">
                            <h2>Vision Input</h2>
                            <dl class="diagnostics-inline-stats">
                                <dt>Vision frames</dt>
                                <dd>@Display(selectedEntry.RawFrame)</dd>
                                <dt>Cameras</dt>
                                <dd>@Display(selectedEntry.RawCamera)</dd>
                                <dt>Detected balls</dt>
                                <dd>@selectedEntry.RawBallCount</dd>
                            </dl>
                            <pre class="diagnostics-detail-summary">@Display(selectedEntry.RawBallDetails)</pre>
                            <h3>Yellow</h3>
                            <pre class="diagnostics-detail-list">@Display(selectedEntry.RawYellowDetails)</pre>
                            <h3>Blue</h3>
                            <pre class="diagnostics-detail-list">@Display(selectedEntry.RawBlueDetails)</pre>
                        </section>

                        <section class="diagnostics-detail-panel">
                            <h2>Tracker Output</h2>
                            <dl class="diagnostics-inline-stats">
                                <dt>Output frame</dt>
                                <dd>@Display(selectedEntry.TrackedFrame)</dd>
                                <dt>Tracked balls</dt>
                                <dd>@selectedEntry.TrackedBallCount</dd>
                                <dt>Tracked robots</dt>
                                <dd>@selectedEntry.TrackedRobotCount</dd>
                            </dl>
                            <pre class="diagnostics-detail-summary">@Display(selectedEntry.TrackedBallDetails)</pre>
                            <h3>Robots</h3>
                            <pre class="diagnostics-detail-list diagnostics-detail-list--robots">@Display(selectedEntry.TrackedRobotDetails)</pre>
                        </section>
                    </div>
                }
            </main>
        </div>

        @if (entries.Count > 0)
        {
            <div class="diagnostics-scrubber">
                <div class="diagnostics-scrubber__playback" aria-label="Diagnostics playback controls">
                    <div class="diagnostics-playback__transport">
                        @if (playbackMode == DiagnosticsPlaybackMode.Play)
                        {
                            <button type="button"
                                    class="diagnostics-playback__button is-active"
                                    title="Stop"
                                    aria-label="Stop"
                                    @onclick="StopPlayback">
                                <span class="diagnostics-playback__icon diagnostics-playback__icon--stop" aria-hidden="true"></span>
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="diagnostics-playback__button"
                                    disabled="@(!CanPlayback)"
                                    title="Play"
                                    aria-label="Play"
                                    @onclick="@(() => StartPlaybackAsync(DiagnosticsPlaybackMode.Play))">
                                <span class="diagnostics-playback__icon diagnostics-playback__icon--play" aria-hidden="true"></span>
                            </button>
                        }
                        @if (playbackMode == DiagnosticsPlaybackMode.FastForward)
                        {
                            <button type="button"
                                    class="diagnostics-playback__button is-active"
                                    title="Stop"
                                    aria-label="Stop"
                                    @onclick="StopPlayback">
                                <span class="diagnostics-playback__icon diagnostics-playback__icon--stop" aria-hidden="true"></span>
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="diagnostics-playback__button"
                                    disabled="@(!CanPlayback)"
                                    title="Fast forward"
                                    aria-label="Fast forward"
                                    @onclick="StartFastForwardPlaybackAsync">
                                <span class="diagnostics-playback__icon diagnostics-playback__icon--fast-forward" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                    <div class="diagnostics-playback-tabs" role="tablist" aria-label="Playback speed">
                        @foreach (var choice in DiagnosticsPlaybackState.PlaybackSpeedChoices)
                        {
                            <button type="button"
                                    class="@PlaybackSpeedChoiceButtonClass(choice)"
                                    role="tab"
                                    aria-selected="@IsSelectedPlaybackSpeedChoice(choice)"
                                    @onclick="@(() => OnPlaybackSpeedChoiceClicked(choice))">
                                @choice.Label
                            </button>
                        }
                    </div>
                </div>
                <input type="range"
                       class="diagnostics-scrubber__range"
                       min="0"
                       max="@MaxReplayTimelineIndex"
                       value="@SelectedReplayTimelineIndex"
                       @oninput="OnTimelineScrubbed"
                       @onwheel="OnTimelineWheel"
                       @onwheel:preventDefault="true"
                       aria-label="Diagnostics timeline scrubber" />
                <div class="diagnostics-scrubber__meta">
                    <span>@(SelectedReplayTimelineIndex + 1) / @ReplayTimelineCount</span>
                    <span>@(selectedReplayTimelineTick is null ? selectedEntry is null ? "-" : FormatTime(selectedEntry.Timestamp) : FormatTime(selectedReplayTimelineTick.ReceivedAt))</span>
                </div>
            </div>
        }
    }
</section>

@if (isProfileSettingsModalOpen && profileMetadata is not null)
{
    <div class="diagnostics-modal" role="dialog" aria-modal="true" aria-label="Profile settings" @onclick="CloseProfileSettings">
        <div class="diagnostics-modal__panel" @onclick:stopPropagation="true">
            <header class="diagnostics-modal__header">
                <div>
                    <span>Profile settings</span>
                    <strong>@profileMetadata.ProfileName</strong>
                </div>
                <button type="button" class="diagnostics-button" @onclick="CloseProfileSettings">Close</button>
            </header>
            <div class="diagnostics-profile__grid">
                <section>
                    <h2>Configured profile</h2>
                    <pre>@profileMetadata.ConfiguredProfileJson</pre>
                </section>
                <section>
                    <h2>Resolved settings</h2>
                    <pre>@profileMetadata.ResolvedSettingsJson</pre>
                </section>
            </div>
        </div>
    </div>
}
