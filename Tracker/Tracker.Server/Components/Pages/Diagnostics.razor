@page "/diagnostics"
@using System.Globalization
@using Tracker.Core
@using Tracker.Server.Components.Vision
@using Tracker.Server.Tracking
@inject TrackerDiagnosticsLogReader LogReader
@inject TrackerRenderSnapshotLogReader RenderSnapshotReader

<PageTitle>Diagnostics</PageTitle>

<section class="@ShellClass()">
    <header class="diagnostics-header">
        <div class="diagnostics-status">
            <div>
                <span>Files</span>
                <strong>@logFiles.Count</strong>
            </div>
            <div>
                <span>Entries</span>
                <strong>@entries.Count</strong>
            </div>
            <div>
                <span>Skipped</span>
                <strong>@(snapshot?.SkippedLineCount ?? 0)</strong>
            </div>
            <div>
                <span>Selected</span>
                <strong>@(selectedEntry?.TrackedFrame ?? "-")</strong>
            </div>
        </div>

        <div class="diagnostics-toolbar">
            <select class="diagnostics-select"
                    value="@selectedLogPath"
                    @onchange="OnLogFileChanged"
                    aria-label="Diagnostics log file">
                @foreach (var file in logFiles)
                {
                    <option value="@file.FullPath">@file.FileName</option>
                }
            </select>
            <button type="button" class="diagnostics-button" @onclick="ReloadAsync">Reload</button>
        </div>
    </header>

    @if (entries.Count > 0)
    {
        <div class="diagnostics-scrubber">
            <input type="range"
                   class="diagnostics-scrubber__range"
                   min="0"
                   max="@MaxEntryIndex"
                   value="@SelectedEntryIndex"
                   @oninput="OnTimelineScrubbed"
                   aria-label="Diagnostics timeline scrubber" />
            <div class="diagnostics-scrubber__meta">
                <span>@(SelectedEntryIndex + 1) / @entries.Count</span>
                <span>@(selectedEntry is null ? "-" : FormatTime(selectedEntry.Timestamp))</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(snapshot?.Error))
    {
        <div class="diagnostics-alert">@snapshot.Error</div>
    }
    else if (logFiles.Count == 0)
    {
        <div class="diagnostics-alert">No tracker diagnostics logs found.</div>
    }
    else
    {
        <div class="diagnostics-grid">
            <aside class="diagnostics-timeline" aria-label="Diagnostics timeline">
                @foreach (var entry in entries)
                {
                    <button type="button"
                            class="@TimelineItemClass(entry)"
                            @onclick="@(() => SelectEntry(entry))">
                        <span class="diagnostics-timeline__time">@FormatTime(entry.Timestamp)</span>
                        <span class="diagnostics-timeline__frame">tracked @entry.TrackedFrame</span>
                        <span class="diagnostics-timeline__counts">
                            raw @entry.RawBallCount / tracked @entry.TrackedBallCount
                        </span>
                    </button>
                }
            </aside>

            <main class="diagnostics-detail">
                @if (selectedEntry is null)
                {
                    <div class="diagnostics-empty">No entry selected.</div>
                }
                else
                {
                    <div class="diagnostics-detail__header">
                        <div>
                            <span>Time</span>
                            <strong>@selectedEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture)</strong>
                        </div>
                        <div>
                            <span>Profile</span>
                            <strong>@selectedEntry.ProfileName</strong>
                        </div>
                        <div>
                            <span>Line</span>
                            <strong>@selectedEntry.LineNumber</strong>
                        </div>
                    </div>

                    @if (selectedRenderSnapshot is not null)
                    {
                        <div class="diagnostics-render">
                            <section>
                                <h2>Raw Field</h2>
                                <VisionFieldCanvas Geometry="CreateGeometry(selectedRenderSnapshot.Frame.GeometrySnapshot)"
                                                   Balls="CreateRawBalls(selectedRenderSnapshot.Frame)"
                                                   RobotsYellow="CreateRawYellowRobots(selectedRenderSnapshot.Frame)"
                                                   RobotsBlue="CreateRawBlueRobots(selectedRenderSnapshot.Frame)" />
                            </section>
                            <section>
                                <h2>Tracked Field</h2>
                                <VisionFieldCanvas Geometry="trackedRenderView.Geometry"
                                                   Balls="trackedRenderView.Balls"
                                                   RobotsYellow="trackedRenderView.RobotsYellow"
                                                   RobotsBlue="trackedRenderView.RobotsBlue" />
                            </section>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(renderSnapshotError))
                    {
                        <div class="diagnostics-render-alert">@renderSnapshotError</div>
                    }

                    <div class="diagnostics-detail__columns">
                        <section>
                            <h2>Raw</h2>
                            <dl>
                                <dt>Frame</dt>
                                <dd>@Display(selectedEntry.RawFrame)</dd>
                                <dt>Camera</dt>
                                <dd>@Display(selectedEntry.RawCamera)</dd>
                                <dt>Balls</dt>
                                <dd>@selectedEntry.RawBallCount</dd>
                            </dl>
                            <pre>@Display(selectedEntry.RawBallDetails)</pre>
                            <h3>Yellow</h3>
                            <pre>@Display(selectedEntry.RawYellowDetails)</pre>
                            <h3>Blue</h3>
                            <pre>@Display(selectedEntry.RawBlueDetails)</pre>
                        </section>

                        <section>
                            <h2>Tracked</h2>
                            <dl>
                                <dt>Frame</dt>
                                <dd>@Display(selectedEntry.TrackedFrame)</dd>
                                <dt>Balls</dt>
                                <dd>@selectedEntry.TrackedBallCount</dd>
                                <dt>Robots</dt>
                                <dd>@selectedEntry.TrackedRobotCount</dd>
                            </dl>
                            <pre>@Display(selectedEntry.TrackedBallDetails)</pre>
                            <h3>Robots</h3>
                            <pre>@Display(selectedEntry.TrackedRobotDetails)</pre>
                        </section>
                    </div>
                }
            </main>
        </div>
    }
</section>

@code {
    private IReadOnlyList<TrackerDiagnosticsLogFile> logFiles = [];
    private TrackerDiagnosticsLogSnapshot? snapshot;
    private IReadOnlyList<TrackerDiagnosticsLogEntry> entries = [];
    private string? selectedLogPath;
    private TrackerDiagnosticsLogEntry? selectedEntry;
    private TrackerRenderSnapshotView? selectedRenderSnapshot;
    private IReadOnlyDictionary<uint, TrackerRenderSnapshotView> renderSnapshotsByFrame =
        new Dictionary<uint, TrackerRenderSnapshotView>();
    private string? renderSnapshotError;
    private int MaxEntryIndex => Math.Max(0, entries.Count - 1);

    private int SelectedEntryIndex => selectedEntry is null
        ? 0
        : FindEntryIndex(selectedEntry);

    private TrackedVisionViewState trackedRenderView =>
        selectedRenderSnapshot is null
            ? TrackedVisionViewState.FromSnapshot(new TrackedSnapshot(null, null, "-", 0, 0))
            : TrackedVisionViewState.FromSnapshot(new TrackedSnapshot(
                selectedRenderSnapshot.Frame,
                selectedRenderSnapshot.ReceivedAt,
                selectedRenderSnapshot.Frame.Metadata.ProfileName ?? "-",
                0,
                0));

    protected override void OnInitialized()
    {
        LoadFiles();
        LoadSelectedFile();
    }

    private Task ReloadAsync()
    {
        LoadFiles();
        LoadSelectedFile();
        return Task.CompletedTask;
    }

    private Task OnLogFileChanged(ChangeEventArgs args)
    {
        var requestedLogPath = args.Value?.ToString();
        selectedLogPath = logFiles.FirstOrDefault(file => file.FullPath == requestedLogPath)?.FullPath;
        LoadSelectedFile();
        return Task.CompletedTask;
    }

    private void LoadFiles()
    {
        logFiles = LogReader.ListFiles();
        if (selectedLogPath is null || !logFiles.Any(file => file.FullPath == selectedLogPath))
        {
            selectedLogPath = logFiles.FirstOrDefault()?.FullPath;
        }
    }

    private void LoadSelectedFile()
    {
        if (selectedLogPath is null)
        {
            snapshot = null;
            entries = [];
            selectedEntry = null;
            selectedRenderSnapshot = null;
            renderSnapshotsByFrame = new Dictionary<uint, TrackerRenderSnapshotView>();
            renderSnapshotError = null;
            return;
        }

        snapshot = LogReader.ReadFile(selectedLogPath);
        entries = snapshot.Entries;
        selectedEntry = entries.FirstOrDefault();
        LoadRenderSnapshotIndex();
        LoadSelectedRenderSnapshot();
    }

    private void SelectEntry(TrackerDiagnosticsLogEntry entry)
    {
        selectedEntry = entry;
        LoadSelectedRenderSnapshot();
    }

    private void OnTimelineScrubbed(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, out var index))
        {
            return;
        }

        SelectEntryByIndex(index);
    }

    private void SelectEntryByIndex(int index)
    {
        if (entries.Count == 0)
        {
            selectedEntry = null;
            selectedRenderSnapshot = null;
            renderSnapshotsByFrame = new Dictionary<uint, TrackerRenderSnapshotView>();
            renderSnapshotError = null;
            return;
        }

        selectedEntry = entries[Math.Clamp(index, 0, entries.Count - 1)];
        LoadSelectedRenderSnapshot();
    }

    private int FindEntryIndex(TrackerDiagnosticsLogEntry entry)
    {
        for (var index = 0; index < entries.Count; index++)
        {
            if (ReferenceEquals(entries[index], entry))
            {
                return index;
            }
        }

        return 0;
    }

    private string ShellClass()
    {
        return selectedRenderSnapshot is null
            ? "diagnostics-shell"
            : "diagnostics-shell diagnostics-shell--render";
    }

    private string TimelineItemClass(TrackerDiagnosticsLogEntry entry)
    {
        var classes = new List<string> { "diagnostics-timeline__item" };
        if (ReferenceEquals(entry, selectedEntry))
        {
            classes.Add("is-selected");
        }

        return string.Join(" ", classes);
    }

    private static string FormatTime(DateTimeOffset timestamp)
    {
        return timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture);
    }

    private static string Display(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private void LoadSelectedRenderSnapshot()
    {
        if (selectedLogPath is null || selectedEntry is null)
        {
            selectedRenderSnapshot = null;
            renderSnapshotError = null;
            return;
        }

        if (!uint.TryParse(selectedEntry.TrackedFrame, NumberStyles.Integer, CultureInfo.InvariantCulture, out var frameNumber))
        {
            selectedRenderSnapshot = null;
            renderSnapshotError = $"Tracked frame '{selectedEntry.TrackedFrame}' is not a numeric frame number.";
            return;
        }

        if (renderSnapshotsByFrame.TryGetValue(frameNumber, out var renderSnapshot))
        {
            selectedRenderSnapshot = renderSnapshot;
            renderSnapshotError = null;
            return;
        }

        selectedRenderSnapshot = null;
        renderSnapshotError = $"Render snapshot for tracked frame '{selectedEntry.TrackedFrame}' was not found.";
    }

    private void LoadRenderSnapshotIndex()
    {
        renderSnapshotsByFrame = new Dictionary<uint, TrackerRenderSnapshotView>();
        renderSnapshotError = null;

        if (selectedLogPath is null)
        {
            return;
        }

        var result = RenderSnapshotReader.ReadIndex(selectedLogPath);
        if (result.Index is null)
        {
            renderSnapshotError = result.Error;
            return;
        }

        renderSnapshotsByFrame = result.Index.SnapshotsByFrame;
    }

    private static SSL_GeometryData? CreateGeometry(TrackerGeometrySnapshot? geometrySnapshot)
    {
        if (geometrySnapshot is null)
        {
            return null;
        }

        return new SSL_GeometryData
        {
            Field = new SSL_GeometryFieldSize
            {
                FieldLength = geometrySnapshot.FieldLengthMm,
                FieldWidth = geometrySnapshot.FieldWidthMm,
                GoalWidth = geometrySnapshot.GoalWidthMm,
                GoalDepth = geometrySnapshot.GoalDepthMm,
                BoundaryWidth = geometrySnapshot.BoundaryWidthMm,
                BoundaryWidthGoalLine = geometrySnapshot.BoundaryWidthGoalLineMm,
                LineThickness = geometrySnapshot.LineThicknessMm,
            },
        };
    }

    private static IReadOnlyList<SSL_DetectionBall> CreateRawBalls(TrackerFrame frame)
    {
        return frame.SourceDetections
            .SelectMany(detection => detection.Balls)
            .ToArray();
    }

    private static IReadOnlyList<SSL_DetectionRobot> CreateRawYellowRobots(TrackerFrame frame)
    {
        return frame.SourceDetections
            .SelectMany(detection => detection.RobotsYellow)
            .ToArray();
    }

    private static IReadOnlyList<SSL_DetectionRobot> CreateRawBlueRobots(TrackerFrame frame)
    {
        return frame.SourceDetections
            .SelectMany(detection => detection.RobotsBlue)
            .ToArray();
    }
}
