@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@using Tracker.DebugHost.Vision

<aside class="details-panel">
    <div class="details-panel__selector" role="tablist" aria-label="Vision source selector">
        <button type="button"
                class="@SourceButtonClass("aggregate")"
                @onclick="@(() => SelectViewAsync("aggregate"))">
            Aggregate
        </button>
        @foreach (var camera in Cameras)
        {
            var key = $"camera:{camera.CameraId}";
            <button type="button"
                    class="@SourceButtonClass(key)"
                    @onclick="@(() => SelectViewAsync(key))">
                Camera @camera.CameraId
            </button>
        }
    </div>

    <div class="details-panel__meta">
        <div>
            <span>View</span>
            <strong>@ViewLabel</strong>
        </div>
        <div>
            <span>Frame</span>
            <strong>@FrameLabel</strong>
        </div>
        <div>
            <span>Camera</span>
            <strong>@CameraLabel</strong>
        </div>
        <div>
            <span>Source</span>
            <strong>@SourceLabel</strong>
        </div>
    </div>

    <div class="details-panel__tabs" role="tablist" aria-label="Vision details tabs">
        @foreach (var tab in Tabs)
        {
            <button type="button"
                    class="@TabButtonClass(tab.Key)"
                    @onclick="@(() => SelectTab(tab.Key))">
                @tab.Label
            </button>
        }
    </div>

    <div class="details-panel__body">
        @switch (selectedTab)
        {
            case VisionDetailsTab.Balls:
                <table>
                    <thead>
                        <tr>
                            <th>Conf</th>
                            <th>X</th>
                            <th>Y</th>
                            <th>Z</th>
                            <th>Pixel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Balls.Count > 0)
                        {
                            @foreach (var ball in Balls)
                            {
                                <tr>
                                    <td>@N(ball.Confidence)</td>
                                    <td>@N(ball.X)</td>
                                    <td>@N(ball.Y)</td>
                                    <td>@N(ball.Z)</td>
                                    <td>@N(ball.PixelX), @N(ball.PixelY)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5">No balls</td></tr>
                        }
                    </tbody>
                </table>
                break;
            case VisionDetailsTab.RobotsYellow:
                @RobotTable(RobotsYellow)
                break;
            case VisionDetailsTab.RobotsBlue:
                @RobotTable(RobotsBlue)
                break;
            case VisionDetailsTab.Geometry:
                <table>
                    <thead>
                        <tr>
                            <th>Camera</th>
                            <th>Focal</th>
                            <th>Principal</th>
                            <th>Image</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Geometry?.Calib is { Count: > 0 })
                        {
                            @foreach (var calib in Geometry.Calib)
                            {
                                <tr>
                                    <td>@calib.CameraId</td>
                                    <td>@N(calib.FocalLength)</td>
                                    <td>@N(calib.PrincipalPointX), @N(calib.PrincipalPointY)</td>
                                    <td>@calib.PixelImageWidth x @calib.PixelImageHeight</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4">No calibration</td></tr>
                        }
                    </tbody>
                </table>
                break;
            default:
                <pre class="details-panel__json">@RawJson</pre>
                break;
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired]
    public string ViewLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string FrameLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string CameraLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SourceLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string RawJson { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<VisionCameraSnapshot> Cameras { get; set; } = Array.Empty<VisionCameraSnapshot>();

    [Parameter, EditorRequired]
    public string SelectedViewKey { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback<string> OnSelectView { get; set; }

    [Parameter]
    public SSL_GeometryData? Geometry { get; set; }

    [Parameter]
    public IReadOnlyList<SSL_DetectionBall> Balls { get; set; } = Array.Empty<SSL_DetectionBall>();

    [Parameter]
    public IReadOnlyList<SSL_DetectionRobot> RobotsYellow { get; set; } = Array.Empty<SSL_DetectionRobot>();

    [Parameter]
    public IReadOnlyList<SSL_DetectionRobot> RobotsBlue { get; set; } = Array.Empty<SSL_DetectionRobot>();

    private VisionDetailsTab selectedTab = VisionDetailsTab.RawJson;

    private static IReadOnlyList<(VisionDetailsTab Key, string Label)> Tabs { get; } =
    [
        (VisionDetailsTab.RawJson, "JSON"),
        (VisionDetailsTab.Balls, "Balls"),
        (VisionDetailsTab.RobotsYellow, "Yellow"),
        (VisionDetailsTab.RobotsBlue, "Blue"),
        (VisionDetailsTab.Geometry, "Geometry"),
    ];

    private static string N(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }

    private void SelectTab(VisionDetailsTab tab)
    {
        selectedTab = tab;
    }

    private string TabButtonClass(VisionDetailsTab tab)
    {
        return selectedTab == tab ? "details-panel__tab is-active" : "details-panel__tab";
    }

    private string SourceButtonClass(string key)
    {
        return SelectedViewKey == key ? "details-panel__source-button is-active" : "details-panel__source-button";
    }

    private Task SelectViewAsync(string key)
    {
        return OnSelectView.InvokeAsync(key);
    }

    private static RenderFragment RobotTable(IEnumerable<SSL_DetectionRobot> robots) => builder =>
    {
        var rows = robots.ToArray();
        var sequence = 0;

        builder.OpenElement(sequence++, "table");
        builder.AddMarkupContent(sequence++, "<thead><tr><th>ID</th><th>Conf</th><th>X</th><th>Y</th><th>Ori</th><th>Pixel</th></tr></thead>");
        builder.OpenElement(sequence++, "tbody");

        if (rows.Length == 0)
        {
            builder.AddMarkupContent(sequence++, "<tr><td colspan=\"6\">No robots</td></tr>");
        }
        else
        {
            foreach (var robot in rows)
            {
                builder.OpenElement(sequence++, "tr");
                AddCell(builder, ref sequence, robot.RobotId.ToString(CultureInfo.InvariantCulture));
                AddCell(builder, ref sequence, N(robot.Confidence));
                AddCell(builder, ref sequence, N(robot.X));
                AddCell(builder, ref sequence, N(robot.Y));
                AddCell(builder, ref sequence, N(robot.Orientation));
                AddCell(builder, ref sequence, $"{N(robot.PixelX)}, {N(robot.PixelY)}");
                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private static void AddCell(RenderTreeBuilder builder, ref int sequence, string value)
    {
        builder.OpenElement(sequence++, "td");
        builder.AddContent(sequence++, value);
        builder.CloseElement();
    }

    private enum VisionDetailsTab
    {
        RawJson,
        Balls,
        RobotsYellow,
        RobotsBlue,
        Geometry,
    }
}
