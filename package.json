{
  "name": "ibisduck-doc-tooling",
  "private": true,
  "version": "0.0.0",
  "description": "Repository-local Markdown lint and spellcheck tooling for IbisDuck.",
  "scripts": {
    "lint:md:setup": "npm ci && node tools/lint/scripts/setup-python-lint.js",
    "lint:md": "npm run lint:md:text && npm run lint:md:spell && npm run lint:md:whitelist",
    "lint:md:targets": "node tools/lint/scripts/list-markdown-targets.js",
    "lint:md:text": "node tools/lint/scripts/run-markdown-targets.js text",
    "lint:md:spell": "node tools/lint/scripts/run-markdown-targets.js spell",
    "lint:md:whitelist": "node tools/lint/scripts/run-python-script.js tools/lint/scripts/check-markdown-whitelist-sudachi.py",
    "lint:md:whitelist:legacy": "node tools/lint/scripts/check-markdown-whitelist.js",
    "lint:md:vocab": "node tools/lint/scripts/run-python-script.js tools/lint/scripts/extract-markdown-vocabulary-sudachi.py --synonyms none"
  },
  "devDependencies": {
    "cspell": "^9.2.1",
    "textlint": "^15.7.0",
    "textlint-rule-prh": "^6.1.0",
    "yaml": "^2.9.0"
  }
}
